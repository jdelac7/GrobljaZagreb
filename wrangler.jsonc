{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zagreb-groblja",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tiles/*"]
  }
}
